\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mitmalfigures}[2026/03/30 Reusable figure primitives]

% Assumes tikz/pgfplots/MIT colors are loaded (via mitmalpackages).
\usetikzlibrary{arrows,calc,fit,positioning}
\usetikzlibrary{shapes.misc}

% Use MIT color cycle for plots.
\pgfplotsset{cycle list name=mitcolormark}
\pgfplotsset{every axis/.append style={font=\footnotesize}}

% Reusable signal plotting styles.
\pgfplotsset{
  signal/.style={
    color=MITDarkerBlue,
    no marks,
  },
  signalIncluded/.style={
    color=MITDarkerBlue,
    mark=*,
    only marks,
    every mark/.append style={fill=MITDarkerBlue},
  },
  signalExcluded/.style={
    signalIncluded,
    every mark/.append style={fill=MITWhite},
  },
}

% Generic helper styles.
\tikzset{cross/.style={cross out, draw=black, minimum size=2*(#1-\pgflinewidth), inner sep=0pt, outer sep=0pt},cross/.default={1pt}}
\tikzset{inner xseps/.style 2 args={inner xsep=#1 + #2,xshift=#2 - #1}}
\tikzset{inner yseps/.style 2 args={inner ysep=#1 + #2,yshift=#2 - #1}}

% Draw centered vehicle icon from file.
\newcommand{\drawCarWithCenter}[2]{%
  \node[opacity=0.75] at #1 {\includegraphics[width=1cm,angle=#2,origin=c]{pics/ego_vehicle.pdf}};
  \node[cross=0.045cm, opacity=0.75] at #1 {};
}

% Common plot constants.
\newcommand*{\plotwidth}{6.5cm}
\newcommand*{\yticklabelwidth}{1.6cm}
\newcommand*{\boxextend}{0.5}

% Minimal vessel shape helper.
\def\vessel#1#2#3#4#5{
  \begin{scope}[shift={#1}, rotate=#2]
    \draw [fill=#3,draw=#3](1, -1) -- (2, 0) -- (1, 1) -- cycle;
    \draw [fill=#3,draw=#3](-1, -1) rectangle (1, 1);
    \node at (0.5, 0) {#4};
    \coordinate (front_#5) at (2, 0) {};
  \end{scope}
}

