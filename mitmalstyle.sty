\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mitmalstyle}[2026/03/30 Reusable article styling]

% llncs defines proof; avoid amsthm conflict.
\makeatletter
\@ifclassloaded{llncs}{%
  \let\proof\relax
  \let\endproof\relax
}{}
\makeatother

% Package stack and figure/image primitives.
\RequirePackage{mitmalpackages}
\RequirePackage{mitmalfigures}

% Inline/normal TODO shortcuts.
\let\mitmaltodo\todo
\RenewDocumentCommand{\todo}{m}{\mitmaltodo[inline,color=MITDarkYellow]{#1}}
\NewDocumentCommand{\todoIL}{m}{\mitmaltodo[color=MITDarkYellow]{#1}}
\NewDocumentCommand{\rfc}{m}{\mitmaltodo[inline,color=MITBlue!30]{#1}}
\NewDocumentCommand{\rfcIL}{m}{\mitmaltodo[color=MITBlue!30]{#1}}

% Force abbreviated cleveref names, including sentence starts.
\crefname{section}{Sec.}{Secs.}
\Crefname{section}{Sec.}{Secs.}
\crefname{table}{Tab.}{Tabs.}
\Crefname{table}{Tab.}{Tabs.}
\crefname{equation}{Eq.}{Eqs.}
\Crefname{equation}{Eq.}{Eqs.}
\crefname{algorithm}{Alg.}{Algs.}
\Crefname{algorithm}{Alg.}{Algs.}
\crefname{definition}{Def.}{Defs.}
\Crefname{definition}{Def.}{Defs.}
\crefname{lemma}{Lemma}{Lemmas}
\Crefname{lemma}{Lemma}{Lemmas}
\crefname{theorem}{Theorem}{Theorems}
\Crefname{theorem}{Theorem}{Theorems}
\crefname{corollary}{Corollary}{Corollaries}
\Crefname{corollary}{Corollary}{Corollaries}
\crefname{proposition}{Proposition}{Propositions}
\Crefname{proposition}{Proposition}{Propositions}
\providecommand{\creflastconjunction}{, and~}
\renewcommand{\creflastconjunction}{, and~}


\endinput
