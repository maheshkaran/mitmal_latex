\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mitmalstyle}[2026/03/30 Reusable article styling]

% llncs defines proof; avoid amsthm conflict.
\makeatletter
\@ifclassloaded{llncs}{%
  \let\proof\relax
  \let\endproof\relax
}{}
\makeatother

% Package stack and figure/image primitives.
\RequirePackage{mitmalpackages}
\RequirePackage{mitmalfigures}

% Inline/normal TODO shortcuts.
\newcommand{\todo}[1]{\todo[inline, color=MITDarkYellow]{#1}}
\newcommand{\todoIL}[1]{\todo[color=MITDarkYellow]{#1}}
\newcommand{\rfc}[1]{\todo[inline, color=MITBlue!30]{#1}}
\newcommand{\rfcIL}[1]{\todo[color=MITBlue!30]{#1}}

% Force abbreviated cleveref names, including sentence starts.
\renewcommand{\Cref}[1]{\cref{#1}}
\crefname{section}{Sec.}{Sec.}
\crefname{table}{Tab.}{Tab.}
\crefname{equation}{Eq.}{Eq.}
\crefname{algorithm}{Alg.}{Alg.}
\crefname{definition}{Def.}{Def.}
\crefname{lemma}{Lemma}{Lemma}
\crefname{theorem}{Theorem}{Theorem}
\crefname{corollary}{Corollary}{Corollary}
\crefname{proposition}{Proposition}{Proposition}
\newcommand{\creflastconjunction}{, and~}

\hyphenation{Irani Liu Althoff CommonRoad CommonOcean COLREGS}

\endinput
